  {387093c3-00bc-4742-a2b0-bf2dd917b82a}, !- Handle
  ems_VAV_1_OptimumStartProg0,            !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {f50174a7-477d-4d11-aa1d-8a67c1205a55}<23.9 && {f50174a7-477d-4d11-aa1d-8a67c1205a55}>1.7, !- Program Line 1
  SET {59d39cea-8430-4f6c-a2e5-2a3e6b8cfe1e} = 29.4, !- Program Line 2
  SET {91d31d4d-79d5-45d0-b6a1-e22da46cbf3e} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {f50174a7-477d-4d11-aa1d-8a67c1205a55}<23.9 && {f50174a7-477d-4d11-aa1d-8a67c1205a55}>1.7, !- Program Line 4
  SET {59d39cea-8430-4f6c-a2e5-2a3e6b8cfe1e} = 29.4, !- Program Line 5
  SET {91d31d4d-79d5-45d0-b6a1-e22da46cbf3e} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {f50174a7-477d-4d11-aa1d-8a67c1205a55}<23.9 && {f50174a7-477d-4d11-aa1d-8a67c1205a55}>1.7, !- Program Line 7
  SET {59d39cea-8430-4f6c-a2e5-2a3e6b8cfe1e} = 29.4, !- Program Line 8
  SET {91d31d4d-79d5-45d0-b6a1-e22da46cbf3e} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {f50174a7-477d-4d11-aa1d-8a67c1205a55}<23.9 && {f50174a7-477d-4d11-aa1d-8a67c1205a55}>1.7, !- Program Line 10
  SET {59d39cea-8430-4f6c-a2e5-2a3e6b8cfe1e} = 29.4, !- Program Line 11
  SET {91d31d4d-79d5-45d0-b6a1-e22da46cbf3e} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {59d39cea-8430-4f6c-a2e5-2a3e6b8cfe1e} = NULL, !- Program Line 14
  SET {91d31d4d-79d5-45d0-b6a1-e22da46cbf3e} = NULL, !- Program Line 15
