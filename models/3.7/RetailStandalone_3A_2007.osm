  {a02c5b55-f19f-4dc7-8d0f-5073f5fd48f7}, !- Handle
  CoreRetailZNPSZACOptimumStartProg0,     !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {2edf793e-2ba3-4c59-a616-a04dc7aa6943}<23.9 && {2edf793e-2ba3-4c59-a616-a04dc7aa6943}>1.7, !- Program Line 1
  SET {e66a91b3-eb52-4ccb-b592-38a2cb78ce09} = 29.4, !- Program Line 2
  SET {84447297-dd58-4dc8-8420-8235691846b6} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {2edf793e-2ba3-4c59-a616-a04dc7aa6943}<23.9 && {2edf793e-2ba3-4c59-a616-a04dc7aa6943}>1.7, !- Program Line 4
  SET {e66a91b3-eb52-4ccb-b592-38a2cb78ce09} = 29.4, !- Program Line 5
  SET {84447297-dd58-4dc8-8420-8235691846b6} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {2edf793e-2ba3-4c59-a616-a04dc7aa6943}<23.9 && {2edf793e-2ba3-4c59-a616-a04dc7aa6943}>1.7, !- Program Line 7
  SET {e66a91b3-eb52-4ccb-b592-38a2cb78ce09} = 29.4, !- Program Line 8
  SET {84447297-dd58-4dc8-8420-8235691846b6} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {2edf793e-2ba3-4c59-a616-a04dc7aa6943}<23.9 && {2edf793e-2ba3-4c59-a616-a04dc7aa6943}>1.7, !- Program Line 10
  SET {e66a91b3-eb52-4ccb-b592-38a2cb78ce09} = 29.4, !- Program Line 11
  SET {84447297-dd58-4dc8-8420-8235691846b6} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {e66a91b3-eb52-4ccb-b592-38a2cb78ce09} = NULL, !- Program Line 14
  SET {84447297-dd58-4dc8-8420-8235691846b6} = NULL, !- Program Line 15
