OS:EnergyManagementSystem:Program,
  {8d920714-3c03-43e4-ac30-510a3263bff8}, !- Handle
  SET_Dining_Light_EMS_Program,           !- Name
  SET Dining_LSr_IP=0.093*Dining_LSr/116.17147592, !- Program Line 1
  IF (Business_Sensor <= 0) && (Dining_LSr_IP >= 0.02), !- Program Line 2
  SET Dining_Light1_Actuator = 0.02*116.17147592/0.09290304, !- Program Line 3
  ELSE,                                   !- Program Line 4
  SET Dining_Light1_Actuator = NULL,      !- Program Line 5
  ENDIF;                                  !- Program Line 6

