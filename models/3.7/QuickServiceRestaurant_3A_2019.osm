OS:EnergyManagementSystem:Program,
  {7477c5f7-12af-4fd7-995b-e0e3bcdc5608}, !- Handle
  SET_Kitchen_Light_EMS_Program,          !- Name
  SET Kitchen_LSr_IP=0.093*Kitchen_LSr/116.17147592, !- Program Line 1
  IF (Business_Sensor <= 0) && (Kitchen_LSr_IP >= 0.02), !- Program Line 2
  SET Kitchen_Light1_Actuator = 0.02*116.17147592/0.09290304, !- Program Line 3
  ELSE,                                   !- Program Line 4
  SET Kitchen_Light1_Actuator = NULL,     !- Program Line 5
  ENDIF;                                  !- Program Line 6

