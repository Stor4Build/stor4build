OS:EnergyManagementSystem:Program,
  {cded0777-59c7-4c4c-8366-ca446a1e042a}, !- Handle
  ems_VAV_POD_3_OptimumStartProg0,        !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {b45fde6b-6ab6-4228-b616-e1ce55be033c}<23.9 && {b45fde6b-6ab6-4228-b616-e1ce55be033c}>1.7, !- Program Line 1
  SET {651aecea-5e86-44ff-9ce1-a7be4a18459c} = 29.4, !- Program Line 2
  SET {8c7f7843-7871-4999-bda8-e0e0b1d3c040} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {b45fde6b-6ab6-4228-b616-e1ce55be033c}<23.9 && {b45fde6b-6ab6-4228-b616-e1ce55be033c}>1.7, !- Program Line 4
  SET {651aecea-5e86-44ff-9ce1-a7be4a18459c} = 29.4, !- Program Line 5
  SET {8c7f7843-7871-4999-bda8-e0e0b1d3c040} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {b45fde6b-6ab6-4228-b616-e1ce55be033c}<23.9 && {b45fde6b-6ab6-4228-b616-e1ce55be033c}>1.7, !- Program Line 7
  SET {651aecea-5e86-44ff-9ce1-a7be4a18459c} = 29.4, !- Program Line 8
  SET {8c7f7843-7871-4999-bda8-e0e0b1d3c040} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {b45fde6b-6ab6-4228-b616-e1ce55be033c}<23.9 && {b45fde6b-6ab6-4228-b616-e1ce55be033c}>1.7, !- Program Line 10
  SET {651aecea-5e86-44ff-9ce1-a7be4a18459c} = 29.4, !- Program Line 11
  SET {8c7f7843-7871-4999-bda8-e0e0b1d3c040} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {651aecea-5e86-44ff-9ce1-a7be4a18459c} = NULL, !- Program Line 14
  SET {8c7f7843-7871-4999-bda8-e0e0b1d3c040} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

