  {b9273026-29dd-4b0f-8537-c75329b16a45}, !- Handle
  ems_VAV_WITH_REHEAT_OptimumStartProg0,  !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {3a990e46-61ed-49ff-a76d-a9b1e2335509}<23.9 && {3a990e46-61ed-49ff-a76d-a9b1e2335509}>1.7, !- Program Line 1
  SET {842d3faa-8ed9-468f-998b-eb780ff3aa4b} = 29.4, !- Program Line 2
  SET {07e11350-cca1-4be5-b53b-22341e5527de} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {3a990e46-61ed-49ff-a76d-a9b1e2335509}<23.9 && {3a990e46-61ed-49ff-a76d-a9b1e2335509}>1.7, !- Program Line 4
  SET {842d3faa-8ed9-468f-998b-eb780ff3aa4b} = 29.4, !- Program Line 5
  SET {07e11350-cca1-4be5-b53b-22341e5527de} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {3a990e46-61ed-49ff-a76d-a9b1e2335509}<23.9 && {3a990e46-61ed-49ff-a76d-a9b1e2335509}>1.7, !- Program Line 7
  SET {842d3faa-8ed9-468f-998b-eb780ff3aa4b} = 29.4, !- Program Line 8
  SET {07e11350-cca1-4be5-b53b-22341e5527de} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {3a990e46-61ed-49ff-a76d-a9b1e2335509}<23.9 && {3a990e46-61ed-49ff-a76d-a9b1e2335509}>1.7, !- Program Line 10
  SET {842d3faa-8ed9-468f-998b-eb780ff3aa4b} = 29.4, !- Program Line 11
  SET {07e11350-cca1-4be5-b53b-22341e5527de} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {842d3faa-8ed9-468f-998b-eb780ff3aa4b} = NULL, !- Program Line 14
  SET {07e11350-cca1-4be5-b53b-22341e5527de} = NULL, !- Program Line 15
