  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {cb8ea190-a82a-4441-af07-16fac268a580}<23.9 && {cb8ea190-a82a-4441-af07-16fac268a580}>1.7, !- Program Line 4
  SET {6a24ba50-dec5-4b49-ad79-fc8ca578b29b} = 29.4, !- Program Line 5
  SET {6f44ba51-5e87-47ee-8097-94c0d0a4713f} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {cb8ea190-a82a-4441-af07-16fac268a580}<23.9 && {cb8ea190-a82a-4441-af07-16fac268a580}>1.7, !- Program Line 7
