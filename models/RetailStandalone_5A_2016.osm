  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {6ec0574a-a84c-46aa-a406-b5a221693db3}<23.9 && {6ec0574a-a84c-46aa-a406-b5a221693db3}>1.7, !- Program Line 1
