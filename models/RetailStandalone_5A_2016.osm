  SET {3958c088-238c-457a-84d1-39fb5efdc649} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {6ec0574a-a84c-46aa-a406-b5a221693db3}<23.9 && {6ec0574a-a84c-46aa-a406-b5a221693db3}>1.7, !- Program Line 4
  SET {2e227a84-e993-45bf-9d1f-009a61cb63ec} = 29.4, !- Program Line 5
  SET {3958c088-238c-457a-84d1-39fb5efdc649} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {6ec0574a-a84c-46aa-a406-b5a221693db3}<23.9 && {6ec0574a-a84c-46aa-a406-b5a221693db3}>1.7, !- Program Line 7
  SET {2e227a84-e993-45bf-9d1f-009a61cb63ec} = 29.4, !- Program Line 8
  SET {3958c088-238c-457a-84d1-39fb5efdc649} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {6ec0574a-a84c-46aa-a406-b5a221693db3}<23.9 && {6ec0574a-a84c-46aa-a406-b5a221693db3}>1.7, !- Program Line 10
  SET {2e227a84-e993-45bf-9d1f-009a61cb63ec} = 29.4, !- Program Line 11
  SET {3958c088-238c-457a-84d1-39fb5efdc649} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {2e227a84-e993-45bf-9d1f-009a61cb63ec} = NULL, !- Program Line 14
  SET {3958c088-238c-457a-84d1-39fb5efdc649} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

