OS:EnergyManagementSystem:Program,
  {1d2105e0-3369-4f5b-8f2e-d7b5259ebf0a}, !- Handle
  CoreRetailZNPSZACOptimumStartProg0,     !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {fe6c2bab-c1ea-48ea-bde1-9bfd0e1b9730}<23.9 && {fe6c2bab-c1ea-48ea-bde1-9bfd0e1b9730}>1.7, !- Program Line 1
  SET {3a0dbad6-a719-441b-a013-da10dd193a91} = 29.4, !- Program Line 2
  SET {1f3897a2-4907-4989-adc4-d3359b5f4cf0} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {fe6c2bab-c1ea-48ea-bde1-9bfd0e1b9730}<23.9 && {fe6c2bab-c1ea-48ea-bde1-9bfd0e1b9730}>1.7, !- Program Line 4
  SET {3a0dbad6-a719-441b-a013-da10dd193a91} = 29.4, !- Program Line 5
  SET {1f3897a2-4907-4989-adc4-d3359b5f4cf0} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {fe6c2bab-c1ea-48ea-bde1-9bfd0e1b9730}<23.9 && {fe6c2bab-c1ea-48ea-bde1-9bfd0e1b9730}>1.7, !- Program Line 7
  SET {3a0dbad6-a719-441b-a013-da10dd193a91} = 29.4, !- Program Line 8
  SET {1f3897a2-4907-4989-adc4-d3359b5f4cf0} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {fe6c2bab-c1ea-48ea-bde1-9bfd0e1b9730}<23.9 && {fe6c2bab-c1ea-48ea-bde1-9bfd0e1b9730}>1.7, !- Program Line 10
  SET {3a0dbad6-a719-441b-a013-da10dd193a91} = 29.4, !- Program Line 11
  SET {1f3897a2-4907-4989-adc4-d3359b5f4cf0} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {3a0dbad6-a719-441b-a013-da10dd193a91} = NULL, !- Program Line 14
  SET {1f3897a2-4907-4989-adc4-d3359b5f4cf0} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

