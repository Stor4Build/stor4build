  {b2925f91-eb8f-48b6-81ac-2c5539de939c}, !- Handle
  ems_5_Zone_PVAV_2_OptimumStartProg0,    !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {48a219ce-8260-4c86-8c89-2e227aa4dcc0}<23.9 && {48a219ce-8260-4c86-8c89-2e227aa4dcc0}>1.7, !- Program Line 1
  SET {55e5915e-7f12-4daf-ac85-808889530f4d} = 29.4, !- Program Line 2
  SET {14a8148b-b6c1-4067-8b2e-fb7ddff3ae63} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {48a219ce-8260-4c86-8c89-2e227aa4dcc0}<23.9 && {48a219ce-8260-4c86-8c89-2e227aa4dcc0}>1.7, !- Program Line 4
  SET {55e5915e-7f12-4daf-ac85-808889530f4d} = 29.4, !- Program Line 5
  SET {14a8148b-b6c1-4067-8b2e-fb7ddff3ae63} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {48a219ce-8260-4c86-8c89-2e227aa4dcc0}<23.9 && {48a219ce-8260-4c86-8c89-2e227aa4dcc0}>1.7, !- Program Line 7
  SET {55e5915e-7f12-4daf-ac85-808889530f4d} = 29.4, !- Program Line 8
  SET {14a8148b-b6c1-4067-8b2e-fb7ddff3ae63} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {48a219ce-8260-4c86-8c89-2e227aa4dcc0}<23.9 && {48a219ce-8260-4c86-8c89-2e227aa4dcc0}>1.7, !- Program Line 10
  SET {55e5915e-7f12-4daf-ac85-808889530f4d} = 29.4, !- Program Line 11
  SET {14a8148b-b6c1-4067-8b2e-fb7ddff3ae63} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {55e5915e-7f12-4daf-ac85-808889530f4d} = NULL, !- Program Line 14
  SET {14a8148b-b6c1-4067-8b2e-fb7ddff3ae63} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

