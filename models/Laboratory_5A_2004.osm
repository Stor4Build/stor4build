  {0f94698a-d5c5-400c-92e1-2570f0db83a4}, !- Handle
  ems_12_Zone_PVAV_OptimumStartProg0,     !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {1fab2549-dfab-4471-a803-afdc4f09d67e}<23.9 && {1fab2549-dfab-4471-a803-afdc4f09d67e}>1.7, !- Program Line 1
  SET {5a2f689b-7745-4e28-ae43-d44730796585} = 29.4, !- Program Line 2
  SET {ed879ea1-4bda-4fcc-b1d6-1238fd7a7e34} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {1fab2549-dfab-4471-a803-afdc4f09d67e}<23.9 && {1fab2549-dfab-4471-a803-afdc4f09d67e}>1.7, !- Program Line 4
  SET {5a2f689b-7745-4e28-ae43-d44730796585} = 29.4, !- Program Line 5
  SET {ed879ea1-4bda-4fcc-b1d6-1238fd7a7e34} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {1fab2549-dfab-4471-a803-afdc4f09d67e}<23.9 && {1fab2549-dfab-4471-a803-afdc4f09d67e}>1.7, !- Program Line 7
  SET {5a2f689b-7745-4e28-ae43-d44730796585} = 29.4, !- Program Line 8
  SET {ed879ea1-4bda-4fcc-b1d6-1238fd7a7e34} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {1fab2549-dfab-4471-a803-afdc4f09d67e}<23.9 && {1fab2549-dfab-4471-a803-afdc4f09d67e}>1.7, !- Program Line 10
  SET {5a2f689b-7745-4e28-ae43-d44730796585} = 29.4, !- Program Line 11
  SET {ed879ea1-4bda-4fcc-b1d6-1238fd7a7e34} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
