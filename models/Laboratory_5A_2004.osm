OS:EnergyManagementSystem:Program,
  {0f188a7b-a1fc-4d85-a105-a47d9cfbafd3}, !- Handle
  ems_Lab_PVAV_All_OA_OptimumStartProg0,  !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {7c5e44f1-2a70-42c2-bddd-abef716b9c72}<23.9 && {7c5e44f1-2a70-42c2-bddd-abef716b9c72}>1.7, !- Program Line 1
  SET {de69d2a1-cf68-456b-b902-d34404396418} = 29.4, !- Program Line 2
  SET {45f525d5-3d3a-4227-bd01-d743fcee8894} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {7c5e44f1-2a70-42c2-bddd-abef716b9c72}<23.9 && {7c5e44f1-2a70-42c2-bddd-abef716b9c72}>1.7, !- Program Line 4
  SET {de69d2a1-cf68-456b-b902-d34404396418} = 29.4, !- Program Line 5
  SET {45f525d5-3d3a-4227-bd01-d743fcee8894} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {7c5e44f1-2a70-42c2-bddd-abef716b9c72}<23.9 && {7c5e44f1-2a70-42c2-bddd-abef716b9c72}>1.7, !- Program Line 7
  SET {de69d2a1-cf68-456b-b902-d34404396418} = 29.4, !- Program Line 8
  SET {45f525d5-3d3a-4227-bd01-d743fcee8894} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {7c5e44f1-2a70-42c2-bddd-abef716b9c72}<23.9 && {7c5e44f1-2a70-42c2-bddd-abef716b9c72}>1.7, !- Program Line 10
  SET {de69d2a1-cf68-456b-b902-d34404396418} = 29.4, !- Program Line 11
  SET {45f525d5-3d3a-4227-bd01-d743fcee8894} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {de69d2a1-cf68-456b-b902-d34404396418} = NULL, !- Program Line 14
  SET {45f525d5-3d3a-4227-bd01-d743fcee8894} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

