OS:EnergyManagementSystem:Program,
  {33ab31c4-df5b-4713-88bc-0d76547e046d}, !- Handle
  ems_VAV_mid_WITH_REHEAT_OptimumStartProg0, !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {3b28da5f-8a10-4a08-8118-e5a669c823b8}<23.9 && {3b28da5f-8a10-4a08-8118-e5a669c823b8}>1.7, !- Program Line 1
  SET {8369197c-e97e-4606-a281-2fa320f58203} = 29.4, !- Program Line 2
  SET {afc85ade-937a-49b2-ad20-001926b25cb1} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {3b28da5f-8a10-4a08-8118-e5a669c823b8}<23.9 && {3b28da5f-8a10-4a08-8118-e5a669c823b8}>1.7, !- Program Line 4
  SET {8369197c-e97e-4606-a281-2fa320f58203} = 29.4, !- Program Line 5
  SET {afc85ade-937a-49b2-ad20-001926b25cb1} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {3b28da5f-8a10-4a08-8118-e5a669c823b8}<23.9 && {3b28da5f-8a10-4a08-8118-e5a669c823b8}>1.7, !- Program Line 7
  SET {8369197c-e97e-4606-a281-2fa320f58203} = 29.4, !- Program Line 8
  SET {afc85ade-937a-49b2-ad20-001926b25cb1} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {3b28da5f-8a10-4a08-8118-e5a669c823b8}<23.9 && {3b28da5f-8a10-4a08-8118-e5a669c823b8}>1.7, !- Program Line 10
  SET {8369197c-e97e-4606-a281-2fa320f58203} = 29.4, !- Program Line 11
  SET {afc85ade-937a-49b2-ad20-001926b25cb1} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {8369197c-e97e-4606-a281-2fa320f58203} = NULL, !- Program Line 14
  SET {afc85ade-937a-49b2-ad20-001926b25cb1} = NULL, !- Program Line 15
