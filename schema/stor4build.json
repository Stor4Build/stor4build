{
  "openapi": "3.1.0",
  "info": {
    "title": "stor4build",
    "description": "The stor4build API for TES calculations",
    "version": "0.4.1"
  },
  "paths": {
    "/simulate": {
      "post": {
        "summary": "Simulate a TES technology, including sizing.",
        "operationId": "simulate_route_simulate_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "TES simulation results as CSV.",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Simulation input or domain validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "message"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Request validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "message"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Server or configuration error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BuildingDataPayload": {
        "properties": {
          "climate": {
            "type": "string",
            "enum": [
              "1A",
              "2A",
              "2B",
              "3A",
              "3B",
              "3C",
              "4A",
              "4B",
              "4C",
              "5A",
              "5B",
              "6A",
              "6B",
              "7A",
              "7B",
              "8A"
            ],
            "title": "Climate"
          },
          "vintage": {
            "type": "integer",
            "title": "Vintage"
          },
          "type": {
            "type": "string",
            "enum": [
              "SecondarySchool",
              "PrimarySchool",
              "SmallOffice",
              "MediumOffice",
              "LargeOffice",
              "LargeHotel",
              "Warehouse",
              "RetailStandalone",
              "RetailStripmall",
              "QuickServiceRestaurant",
              "FullServiceRestaurant",
              "Hospital",
              "Outpatient",
              "Laboratory",
              "LargeDataCenterHighITE",
              "LargeDataCenterLowITE",
              "Courthouse",
              "College"
            ],
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "climate",
          "vintage",
          "type"
        ],
        "title": "BuildingDataPayload"
      },
      "HourMinutePayload": {
        "properties": {
          "hour": {
            "type": "integer",
            "maximum": 23.0,
            "minimum": 0.0,
            "title": "Hour"
          }
        },
        "type": "object",
        "required": [
          "hour"
        ],
        "title": "HourMinutePayload"
      },
      "IntervalPayload": {
        "properties": {
          "begin": {
            "$ref": "#/components/schemas/HourMinutePayload"
          },
          "end": {
            "$ref": "#/components/schemas/HourMinutePayload"
          }
        },
        "type": "object",
        "required": [
          "begin",
          "end"
        ],
        "title": "IntervalPayload"
      },
      "MonthSchedulePayload": {
        "properties": {
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "month": {
            "type": "string",
            "title": "Month"
          },
          "periods": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Periods"
          }
        },
        "type": "object",
        "required": [
          "unit",
          "month",
          "periods"
        ],
        "title": "MonthSchedulePayload"
      },
      "SchedulePayload": {
        "properties": {
          "months": {
            "items": {
              "$ref": "#/components/schemas/MonthSchedulePayload"
            },
            "type": "array",
            "title": "Months"
          }
        },
        "type": "object",
        "title": "SchedulePayload"
      },
      "SimplifiedStorageDataPayload": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "ThermalTank-Ice",
              "ThermalTank-ChilledWater",
              "PackagedIceStorage",
              "ice",
              "water",
              "pcm-1"
            ],
            "title": "Type"
          },
          "capacity": {
            "type": "number",
            "maximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Capacity",
            "default": 100.0
          },
          "charge_interval": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IntervalPayload"
              },
              {
                "type": "null"
              }
            ],
            "title": "Charge Interval"
          },
          "discharge_interval": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IntervalPayload"
              },
              {
                "type": "null"
              }
            ],
            "title": "Discharge Interval"
          },
          "size_fraction": {
            "type": "number",
            "enum": [
              1.0,
              0.9,
              0.8,
              0.7,
              0.6,
              0.5
            ],
            "title": "Size Fraction",
            "default": 1.0
          },
          "medium": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "water",
                  "pcm2x2a"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Medium"
          }
        },
        "type": "object",
        "required": [
          "type"
        ],
        "title": "SimplifiedStorageDataPayload"
      },
      "SimulationRequest": {
        "properties": {
          "baseline": {
            "$ref": "#/components/schemas/BuildingDataPayload"
          },
          "storage": {
            "$ref": "#/components/schemas/SimplifiedStorageDataPayload"
          },
          "energy": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UtilityDataPayload"
              },
              {
                "type": "null"
              }
            ]
          },
          "demand": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UtilityDataPayload"
              },
              {
                "type": "null"
              }
            ]
          },
          "header_style": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "simple",
                  "detailed"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Header Style"
          }
        },
        "type": "object",
        "required": [
          "baseline",
          "storage"
        ],
        "title": "SimulationRequest"
      },
      "UtilityDataPayload": {
        "properties": {
          "costs": {
            "items": {
              "$ref": "#/components/schemas/UtilityRatePayload"
            },
            "type": "array",
            "title": "Costs"
          },
          "schedule": {
            "$ref": "#/components/schemas/SchedulePayload"
          }
        },
        "type": "object",
        "required": [
          "schedule"
        ],
        "title": "UtilityDataPayload"
      },
      "UtilityRatePayload": {
        "properties": {
          "rate": {
            "type": "number",
            "minimum": 0.0,
            "title": "Rate"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "period": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Period"
          }
        },
        "type": "object",
        "required": [
          "rate",
          "unit",
          "period"
        ],
        "title": "UtilityRatePayload"
      }
    }
  }
}
